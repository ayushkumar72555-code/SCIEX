{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCIEX",
  "version": "0.1.0",
  "identifier": "com.sciex.simulation",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SCIEX · Scientific Simulation Environment",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
